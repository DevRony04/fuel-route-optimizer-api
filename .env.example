# Django Settings
DJANGO_SECRET_KEY=django-insecure-fuel-route-optimizer-api-secret-key-12345
DJANGO_DEBUG=True
DJANGO_ENV=development
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL)
# For local running outside Docker, you can use SQLite or local Postgres:
# DATABASE_URL=sqlite:///db.sqlite3
DATABASE_URL=postgres://postgres:postgres@db:5432/fuel_optimizer_db
POSTGRES_DB=fuel_optimizer_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis Cache URL
REDIS_URL=redis://redis:6379/0

# External Routing API (OpenRouteService)
# Get a free key at https://openrouteservice.org/
ORS_API_KEY=your_openrouteservice_api_key_here
